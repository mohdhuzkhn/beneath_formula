{
  "name": "beneath-the-formula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run content:validate && npm test && npm run security:scan && npm run build",
    "content:validate": "tsx scripts/validate.ts",
    "graph:validate": "tsx scripts/validate.ts",
    "links:check": "tsx scripts/validate.ts",
    "content:new": "tsx scripts/content-new.ts",
    "prebuild": "npm run content:validate",
    "search:build": "tsx scripts/search-build.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test:performance": "node scripts/performance.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "build:deployment": "tsx scripts/deploy-build.ts"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "katex": "0.19.0",
    "next": "16.4.2",
    "next-mdx-remote": "6.0.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "29.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
